# =============================================================================
# ArcTrade environment
# Copy to .env and fill in values. Never commit secrets.
# Arc-specific defaults below are from official docs.arc.io (Arc Testnet).
# Mainnet addresses are not published yet. Do not invent them.
# =============================================================================

# --- Database & cache ---
DATABASE_URL=postgresql://arctrade:arctrade@localhost:5432/arctrade?schema=public
REDIS_URL=redis://localhost:6379

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ArcTradeBot

# --- Arc network (verified from https://docs.arc.io) ---
# Testnet only. Mainnet launch is scheduled; do not assume mainnet RPC/chain ID.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_RPC_FALLBACK_URL=https://rpc.drpc.testnet.arc.io
ARC_WSS_URL=wss://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
# Native gas token is USDC. ERC-20 interface (6 decimals):
# https://docs.arc.io/arc/references/contract-addresses
USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
EURC_CONTRACT_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
CIRBTC_CONTRACT_ADDRESS=0xf0C4a4CE82A5746AbAAd9425360Ab04fbBA432BF

# --- App ---
# Leave NODE_ENV unset locally unless you need to override it.
# NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/ArcTradeBot
API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000

# --- Secrets (generate with: openssl rand -hex 32) ---
ENCRYPTION_KEY=
SESSION_SECRET=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Trading provider ---
# circle-swap = Circle Swap Kit (official App Kit swap on Arc Testnet)
# Supported testnet pairs only: USDC, EURC, cirBTC
# https://docs.arc.io/app-kit/swap
TRADING_PROVIDER=circle-swap
TRADING_API_URL=
TRADING_API_KEY=
CIRCLE_KIT_KEY=

# --- Fees (basis points, 1 bps = 0.01%) ---
TRADING_FEE_BPS=5
MAX_SLIPPAGE_BPS=500
QUOTE_TTL_SECONDS=30
TOKEN_POLICY=WARN_UNVERIFIED
ACCOUNTING_METHOD=FIFO

# --- Admin ---
ADMIN_TELEGRAM_IDS=
ADMIN_API_KEY=

# --- Market data ---
# EURC USD reference uses Frankfurter (ECB). cirBTC reference uses CoinGecko BTC.
# Testnet tokens have no financial value; prices are reference pegs only.
MARKET_DATA_EUR_URL="https://api.frankfurter.app/latest?from=EUR&to=USD"
MARKET_DATA_BTC_URL="https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd"

# --- Dev signer isolation ---
# If set, only this encrypted local signer is used. Never a production custody key.
DEV_SIGNER_ENABLED=true
