    "@arctrade/logging": "workspace:*",
    "@arctrade/security": "workspace:*",
    "@arctrade/types": "workspace:*",
    "viem": "^2.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
